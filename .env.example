# --- VK API CONFIG ---
# Токен сообщества (Настройки -> Работа с API)
VK_TOKEN=vk1.a.xxxxxxxxxxxxxxxxxxxxxx

# Код подтверждения сервера (Настройки -> Callback API)
VK_CONFIRMATION_CODE=xxxxxx

# Секретный ключ (Настройки -> Callback API)
VK_SECRET_KEY=xxxxxxxxxxxx

# Секрет Mini App (Настройки -> Мини-приложение) - нужен для /api/user/info и Гримуара
VK_MINI_APP_SECRET=xxxxxxxxxxxx

# ID администратора (для доступа к консоли "админка")
ADMIN_ID=12345678

# ID сообщества
GROUP_ID=219181948


# --- AI CONFIG (Google Gemini) ---
# Ключи через запятую для ротации (https://aistudio.google.com/)
GEMINI_API_KEYS=key1,key2,key3


# --- DATABASE CONFIG (Supabase) ---
# URL проекта (Settings -> API)
SUPABASE_URL=https://your-project.supabase.co

# В ПРОДЕ: service_role ключ (обходит RLS; бот начнет использовать его
# автоматически). После добавления применить Phase B из database/security_fixes.sql
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...(service_role)

# FALLBACK для локальной разработки (Settings -> API -> anon/public)
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...(anon)


# --- CACHE CONFIG (Upstash Redis) ---
# ВАЖНО (аудит 2026-11): код читает именно UPSTASH_REDIS_REST_URL и
# UPSTASH_REDIS_REST_TOKEN (REST API, НЕ протокол rediss://)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# --- PAYMENTS (YooKassa) ---
YOOKASSA_SHOP_ID=xxxxxxxx
YOOKASSA_SECRET_KEY=live_xxxxxxxxxxxx


# --- SYSTEM CONFIG ---
# Порт сервера (для Render ставьте 10000)
PORT=10000

# Режим работы (true - Webhooks, false - Long Polling)
USE_WEBHOOKS=true

# Sentry DSN для мониторинга ошибок (необязательно)
SENTRY_DSN=https://xxxxxxxx@o0.ingest.sentry.io/xxxxxxx
SENTRY_ENV=production
